{
  "name": "trailmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync": "node --disable-warning=ExperimentalWarning scripts/sync.mjs",
    "plain:todo": "node --disable-warning=ExperimentalWarning scripts/plain-todo.mjs",
    "town:report": "node --disable-warning=ExperimentalWarning scripts/town/report.mjs",
    "town:history": "node --disable-warning=ExperimentalWarning scripts/town/history.mjs",
    "build": "vite build && TOWN_ONLY=1 vite build",
    "build:town": "TOWN_ONLY=1 vite build",
    "build:single": "SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@threlte/core": "^8.7.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "yaml": "^2.9.1"
  },
  "description": "A fun progress map for the FW Lite team: roadmap, current work, long bugs and forum requests, from GitHub."
}
